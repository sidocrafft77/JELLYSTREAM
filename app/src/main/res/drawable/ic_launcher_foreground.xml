<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Diamond / Hexagon Facet -->
    <path
        android:pathData="M54,23 L82,39 L82,69 L54,85 L26,69 L26,39 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#50A855F7"
        android:fillColor="#15A855F7" />

    <!-- Jellyfin Jewel Shape Left Wing -->
    <path
        android:pathData="M54,28 L30,42 L30,66 L54,80 L54,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="30"
                android:endX="54"
                android:endY="75"
                android:type="linear">
                <item android:offset="0.0" android:color="#9333EA" />
                <item android:offset="1.0" android:color="#6366F1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Jellyfin Jewel Shape Right Wing -->
    <path
        android:pathData="M54,28 L78,42 L78,66 L54,80 L54,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="30"
                android:endX="78"
                android:endY="75"
                android:type="linear">
                <item android:offset="0.0" android:color="#A855F7" />
                <item android:offset="1.0" android:color="#38BDF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Center Play Glyph -->
    <path
        android:pathData="M48,42 L66,54 L48,66 Z"
        android:fillColor="#FFFFFF" />

    <!-- Cyan highlight accent on play vertex -->
    <path
        android:pathData="M66,54 L61,50.5 L61,57.5 Z"
        android:fillColor="#00E5FF" />

    <!-- Top facet shimmer -->
    <path
        android:pathData="M54,28 L40,36 L54,44 L68,36 Z"
        android:fillColor="#40FFFFFF" />
</vector>
